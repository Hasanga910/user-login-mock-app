# All variables are server-only. Never prefix any of these with NEXT_PUBLIC_.

# Supabase (used only as a Postgres database)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session signing secret (at least 32 chars). Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# Microsoft Entra ID (Azure AD) app registration
AZURE_AD_TENANT_ID=your-tenant-id-or-common
AZURE_AD_CLIENT_ID=your-application-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret-value

# Public base URL of this app. Redirect URI = ${APP_URL}/api/auth/microsoft/callback
APP_URL=http://localhost:3000

# Optional: Resend (https://resend.com) for password reset emails.
# If RESEND_API_KEY is empty, reset links are logged to the server console instead (DEV ONLY).
RESEND_API_KEY=
# Sender, e.g. "Mock Login App <no-reply@yourdomain.com>". Defaults to onboarding@resend.dev,
# which only delivers to the email address of the Resend account owner.
EMAIL_FROM=
